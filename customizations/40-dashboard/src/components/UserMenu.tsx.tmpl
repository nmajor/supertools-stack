// UserMenu — top-right dropdown shown in the dashboard layout. Hand-rolled
// Tailwind dropdown with click-outside dismissal via a window listener; no
// headless-ui / radix / mantine dep. Keeps the dashboard surface small and
// keeps the bundle in line with the auth + marketing visual language.
//
// Surface area is intentionally minimal:
//   - email (read-only label, the dropdown trigger)
//   - Settings link
//   - Sign out button (invokes Better Auth's signOut, then navigates to /)
//
// No avatar, no notifications, no theme toggle — see HANDOFF "Dashboard pages
// are empty placeholders" content philosophy. Future agents can extend.
import { useEffect, useRef, useState } from 'react';
import { Link, useNavigate } from '@tanstack/react-router';
import { signOut } from '../lib/auth-client';

export function UserMenu({ email }: { email: string }) {
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);
  const wrapRef = useRef<HTMLDivElement | null>(null);

  // Click-outside dismissal. Listening on `mousedown` (not `click`) closes the
  // menu before any inner button's onClick fires, which avoids a flicker where
  // the menu re-opens because the trigger itself is the click target on the
  // way back up.
  useEffect(() => {
    if (!open) return;
    function onDown(e: MouseEvent) {
      if (!wrapRef.current) return;
      if (!wrapRef.current.contains(e.target as Node)) setOpen(false);
    }
    window.addEventListener('mousedown', onDown);
    return () => window.removeEventListener('mousedown', onDown);
  }, [open]);

  async function handleSignOut() {
    setOpen(false);
    await signOut();
    navigate({ to: '/' });
  }

  return (
    <div ref={wrapRef} className="relative">
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        className="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50"
        data-testid="user-menu-trigger"
      >
        {email}
      </button>
      {open ? (
        <div
          role="menu"
          className="absolute right-0 mt-1 w-48 rounded-md border border-gray-200 bg-white py-1 shadow-md"
          data-testid="user-menu-panel"
        >
          <Link
            to="/dashboard/settings"
            onClick={() => setOpen(false)}
            className="block px-3 py-2 text-sm text-gray-700 no-underline hover:bg-gray-50"
            role="menuitem"
          >
            Settings
          </Link>
          <button
            type="button"
            onClick={handleSignOut}
            className="block w-full px-3 py-2 text-left text-sm text-gray-700 hover:bg-gray-50"
            role="menuitem"
            data-testid="user-menu-sign-out"
          >
            Sign out
          </button>
        </div>
      ) : null}
    </div>
  );
}
