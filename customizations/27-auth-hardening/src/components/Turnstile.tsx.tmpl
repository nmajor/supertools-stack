// Cloudflare Turnstile widget — thin React wrapper around the official JS API.
//
// Why this component (and not the implicit `class="cf-turnstile"` auto-render
// from the script tag): we need a token callback we can wire into the sign-up
// form's submit handler. The implicit mode handles "drop a checkbox onto a
// classic <form>" but doesn't surface the token to React state.
//
// Lifecycle:
//   1. Ensure the Turnstile script tag is in <head> (idempotent — the global
//      window.turnstile loader is shared across mounts).
//   2. Once window.turnstile is defined, call render(el, { sitekey, callback })
//      and capture the widget id.
//   3. On unmount, call window.turnstile.remove(widgetId) so React StrictMode
//      double-mounts (and normal route changes) don't leak widgets.
//
// We deliberately do NOT take an `onError` prop in v0.1 — Turnstile's managed
// mode auto-handles errors visually and the user can click "Try again". A
// submit-time failure path on the server (verifyTurnstile -> 400) covers the
// case where the user submits before solving.
import { useEffect, useRef } from 'react';

declare global {
  interface Window {
    turnstile?: {
      render: (
        el: string | HTMLElement,
        opts: {
          sitekey: string;
          callback?: (token: string) => void;
          'expired-callback'?: () => void;
          'error-callback'?: () => void;
          theme?: 'light' | 'dark' | 'auto';
          size?: 'normal' | 'compact';
        },
      ) => string;
      remove: (widgetId: string) => void;
      reset: (widgetId?: string) => void;
    };
  }
}

const SCRIPT_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js';

function ensureScript(): void {
  if (typeof document === 'undefined') return;
  if (document.querySelector(`script[src^="${SCRIPT_SRC}"]`)) return;
  const s = document.createElement('script');
  // explicit-render mode keeps the script from auto-scanning the page for
  // class="cf-turnstile" elements (we render imperatively via window.turnstile.render).
  s.src = `${SCRIPT_SRC}?render=explicit`;
  s.async = true;
  s.defer = true;
  document.head.appendChild(s);
}

export interface TurnstileProps {
  siteKey: string;
  onToken: (token: string) => void;
  onExpired?: () => void;
  theme?: 'light' | 'dark' | 'auto';
}

export function Turnstile({
  siteKey,
  onToken,
  onExpired,
  theme = 'auto',
}: TurnstileProps): React.ReactElement {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const widgetIdRef = useRef<string | null>(null);
  // Stash the callbacks in refs so we can mount the widget once with stable
  // function identities and still pick up the latest closure values on each
  // invocation. Without this, every parent re-render would tear down and
  // re-mount the widget.
  const onTokenRef = useRef(onToken);
  const onExpiredRef = useRef(onExpired);
  onTokenRef.current = onToken;
  onExpiredRef.current = onExpired;

  useEffect(() => {
    ensureScript();
    const el = containerRef.current;
    if (!el) return;

    let cancelled = false;
    const interval = window.setInterval(() => {
      if (cancelled) return;
      if (!window.turnstile || !containerRef.current) return;
      window.clearInterval(interval);
      try {
        widgetIdRef.current = window.turnstile.render(containerRef.current, {
          sitekey: siteKey,
          theme,
          callback: (token: string) => onTokenRef.current(token),
          'expired-callback': () => onExpiredRef.current?.(),
        });
      } catch (e) {
        // Render can throw if the same element already has a widget mounted
        // (StrictMode double-mount race). Swallow — the existing widget is
        // fine; the cleanup below will handle it on real unmount.
        console.error('[Turnstile] render failed', e);
      }
    }, 50);

    return () => {
      cancelled = true;
      window.clearInterval(interval);
      const id = widgetIdRef.current;
      if (id && window.turnstile) {
        try {
          window.turnstile.remove(id);
        } catch {
          // already removed; ignore
        }
      }
      widgetIdRef.current = null;
    };
  }, [siteKey, theme]);

  return <div ref={containerRef} data-testid="turnstile-widget" />;
}
