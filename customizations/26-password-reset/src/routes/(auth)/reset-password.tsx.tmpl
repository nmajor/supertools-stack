// Reset-password page — completes the password reset flow. Users land here
// via the email link Better Auth issued in `sendResetPassword`. The link's
// actual URL is `/api/auth/reset-password/{token}?callbackURL=...`; that
// server endpoint validates the token, and on success 302-redirects to the
// `callbackURL` with `?token=VALID_TOKEN` appended (or `?error=INVALID_TOKEN`
// if it expired). So by the time we render here, `token` is already a
// query-string param — we just hand it to `authClient.resetPassword`.
import { useState } from 'react';
import { createFileRoute, redirect, useNavigate } from '@tanstack/react-router';
import { authClient } from '../../lib/auth-client';
import { getServerSession } from '../../lib/auth.functions';

// TanStack Router's search-params parser. Hand-rolled (no zod dep on this
// step — Better Auth pulls zod in transitively, but we don't want to take a
// direct dep just to validate two optional strings). `error` is surfaced by
// Better Auth when the token has already expired; we map it to a friendly
// banner instead of letting the user try to submit and bounce off the API.
type ResetSearch = { token?: string; error?: string };
function validateResetSearch(raw: Record<string, unknown>): ResetSearch {
  const out: ResetSearch = {};
  if (typeof raw.token === 'string') out.token = raw.token;
  if (typeof raw.error === 'string') out.error = raw.error;
  return out;
}

export const Route = createFileRoute('/(auth)/reset-password')({
  component: ResetPassword,
  head: () => ({ meta: [{ title: 'Reset password' }] }),
  validateSearch: validateResetSearch,
  beforeLoad: async () => {
    // Same bounce as the other (auth) routes: an authed visitor shouldn't be
    // here, and exposing the form to them isn't useful.
    const session = await getServerSession();
    if (session?.user) {
      throw redirect({ to: '/dashboard' });
    }
  },
});

function ResetPassword() {
  const navigate = useNavigate();
  const { token, error: searchError } = Route.useSearch();
  const [password, setPassword] = useState('');
  const [confirm, setConfirm] = useState('');
  const [error, setError] = useState<string | null>(
    searchError === 'INVALID_TOKEN'
      ? 'This reset link has expired or is invalid. Request a new one.'
      : null,
  );
  const [pending, setPending] = useState(false);

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError(null);
    if (!token) {
      setError('Missing reset token. Request a new password reset email.');
      return;
    }
    if (password.length < 8) {
      // Mirror the sign-up form's min-length constraint. Better Auth's
      // default minPasswordLength is 8 — if either constraint moves, both
      // need to. There's no shared constant module today; revisit if a third
      // form with the same rule shows up.
      setError('Password must be at least 8 characters.');
      return;
    }
    if (password !== confirm) {
      setError('Passwords do not match.');
      return;
    }
    setPending(true);
    try {
      const res = await authClient.resetPassword({ token, newPassword: password });
      if (res.error) {
        setError(res.error.message ?? 'Could not reset password');
      } else {
        // Send the user to the sign-in page with a fresh slate. Better Auth
        // does NOT auto-sign-in on reset (and we wouldn't want it to — a
        // user who got phished into a reset would re-arm the attacker's
        // session). Forcing a fresh sign-in is the safest path.
        navigate({ to: '/sign-in' });
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Could not reset password');
    } finally {
      setPending(false);
    }
  }

  return (
    <main className="mx-auto flex max-w-sm flex-col px-4 py-12">
      <div className="rounded-lg bg-white p-6 shadow-md sm:p-8">
        <h1 className="mb-1 text-2xl font-semibold text-gray-900">
          Set a new password
        </h1>
        <p className="mb-6 text-sm text-gray-600">
          Choose a new password for your account.
        </p>
        {error ? (
          <div className="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            {error}
          </div>
        ) : null}
        <form onSubmit={onSubmit} className="space-y-4">
          <div>
            <label
              htmlFor="password"
              className="mb-1 block text-sm font-medium text-gray-700"
            >
              New password
            </label>
            <input
              id="password"
              required
              type="password"
              placeholder="At least 8 characters"
              minLength={8}
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-500"
              autoComplete="new-password"
            />
          </div>
          <div>
            <label
              htmlFor="confirm"
              className="mb-1 block text-sm font-medium text-gray-700"
            >
              Confirm new password
            </label>
            <input
              id="confirm"
              required
              type="password"
              placeholder="Re-enter the new password"
              minLength={8}
              value={confirm}
              onChange={(e) => setConfirm(e.target.value)}
              className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-500"
              autoComplete="new-password"
            />
          </div>
          <button
            type="submit"
            disabled={pending || !token}
            className="w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700 disabled:opacity-50"
          >
            {pending ? 'Resetting…' : 'Reset password'}
          </button>
        </form>
        <p className="mt-6 text-center text-sm text-gray-600">
          <a
            href="/sign-in"
            className="text-blue-600 underline hover:text-blue-700"
          >
            Back to sign in
          </a>
        </p>
      </div>
    </main>
  );
}
