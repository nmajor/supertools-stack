// Forgot-password page — kicks off the Better Auth password reset flow by
// asking the user for their email and POSTing it to
// `/api/auth/request-password-reset`. The server-side `sendResetPassword`
// hook (configured in lib/auth.ts by 26-password-reset's install patcher)
// generates a token, persists it, and emails the reset link.
//
// User-enumeration guard: we render the same "if an account exists ..."
// success banner regardless of whether the email resolved to a real user.
// Better Auth's request-password-reset endpoint already does this on the
// server (it returns 200 either way), so we just mirror that here in the UI.
import { useState } from 'react';
import { createFileRoute, redirect } from '@tanstack/react-router';
import { authClient } from '../../lib/auth-client';
import { getServerSession } from '../../lib/auth.functions';

export const Route = createFileRoute('/(auth)/forgot-password')({
  component: ForgotPassword,
  head: () => ({ meta: [{ title: 'Reset password' }] }),
  // Same pre-render redirect as sign-in / sign-up: an authed visitor doesn't
  // have a "forgot password" problem; bounce them to the dashboard.
  beforeLoad: async () => {
    const session = await getServerSession();
    if (session?.user) {
      throw redirect({ to: '/dashboard' });
    }
  },
});

function ForgotPassword() {
  const [email, setEmail] = useState('');
  const [error, setError] = useState<string | null>(null);
  const [sent, setSent] = useState(false);
  const [pending, setPending] = useState(false);

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError(null);
    setPending(true);
    try {
      // Path-based proxy on authClient — `requestPasswordReset` maps to
      // POST /api/auth/request-password-reset. `redirectTo` is the public
      // URL the reset email's link will eventually land the user on (after
      // Better Auth's callback-validation hop strips the token from the
      // path into a `?token=...` query). Use a relative path here so the
      // origin is whatever the browser is currently on (dev vs prod).
      const origin =
        typeof window !== 'undefined' ? window.location.origin : '';
      const res = await authClient.requestPasswordReset({
        email,
        redirectTo: `${origin}/reset-password`,
      });
      if (res.error) {
        setError(res.error.message ?? 'Could not send reset email');
      } else {
        setSent(true);
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Could not send reset email');
    } finally {
      setPending(false);
    }
  }

  return (
    <main className="mx-auto flex max-w-sm flex-col px-4 py-12">
      <div className="rounded-lg bg-white p-6 shadow-md sm:p-8">
        <h1 className="mb-1 text-2xl font-semibold text-gray-900">
          Forgot your password?
        </h1>
        <p className="mb-6 text-sm text-gray-600">
          Enter your email and we'll send you a link to set a new one.
        </p>
        {error ? (
          <div className="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            {error}
          </div>
        ) : null}
        {sent ? (
          // Generic success — never reveal whether the address exists. The
          // server already enforces this (request-password-reset returns 200
          // for unknown emails) but the UI must match or it leaks.
          <div className="mb-3 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">
            If an account exists for that email, we've sent a reset link.
            Check your inbox.
          </div>
        ) : (
          <form onSubmit={onSubmit} className="space-y-4">
            <div>
              <label
                htmlFor="email"
                className="mb-1 block text-sm font-medium text-gray-700"
              >
                Email
              </label>
              <input
                id="email"
                required
                type="email"
                placeholder="you@example.com"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-500"
                autoComplete="email"
              />
            </div>
            <button
              type="submit"
              disabled={pending}
              className="w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700 disabled:opacity-50"
            >
              {pending ? 'Sending…' : 'Send reset link'}
            </button>
          </form>
        )}
        <p className="mt-6 text-center text-sm text-gray-600">
          Remembered it?{' '}
          <a
            href="/sign-in"
            className="text-blue-600 underline hover:text-blue-700"
          >
            Back to sign in
          </a>
        </p>
      </div>
    </main>
  );
}
