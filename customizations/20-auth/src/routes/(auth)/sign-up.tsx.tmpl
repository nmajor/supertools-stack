// Sign-up page — minimal email/password form. Tailwind for layout only
// (centered card, spacing) — no custom colors, rounded corners, or typography
// choices. Per HANDOFF "default unstyled pages with Tailwind-for-layout-only."
import { useState } from 'react';
import { createFileRoute, useNavigate } from '@tanstack/react-router';
import { signUp } from '../../lib/auth-client';

export const Route = createFileRoute('/(auth)/sign-up')({
  component: SignUp,
});

function SignUp() {
  const navigate = useNavigate();
  const [email, setEmail] = useState('');
  const [name, setName] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState<string | null>(null);
  const [pending, setPending] = useState(false);

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError(null);
    setPending(true);
    try {
      const res = await signUp.email({ email, password, name });
      if (res.error) {
        setError(res.error.message ?? 'Sign-up failed');
      } else {
        navigate({ to: '/' });
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Sign-up failed');
    } finally {
      setPending(false);
    }
  }

  return (
    <main className="mx-auto max-w-sm px-4 py-16">
      <h1 className="mb-4 text-xl">Sign up</h1>
      <form onSubmit={onSubmit} className="space-y-3">
        <input
          required
          type="email"
          placeholder="Email"
          value={email}
          onChange={(e) => setEmail(e.target.value)}
          className="block w-full border p-2"
          autoComplete="email"
        />
        <input
          required
          type="text"
          placeholder="Name"
          value={name}
          onChange={(e) => setName(e.target.value)}
          className="block w-full border p-2"
          autoComplete="name"
        />
        <input
          required
          type="password"
          placeholder="Password"
          minLength={8}
          value={password}
          onChange={(e) => setPassword(e.target.value)}
          className="block w-full border p-2"
          autoComplete="new-password"
        />
        {error ? <p className="text-sm">{error}</p> : null}
        <button
          type="submit"
          disabled={pending}
          className="block w-full border px-3 py-2"
        >
          {pending ? 'Creating account...' : 'Create account'}
        </button>
      </form>
      <p className="mt-4 text-sm">
        Have an account?{' '}
        <a href="/sign-in" className="underline">
          Sign in
        </a>
      </p>
    </main>
  );
}
