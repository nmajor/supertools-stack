// Sign-up page — basic auth screen styled with plain Tailwind utilities.
// Card layout, no UI library. Behavior is contract: signUp.email + navigate
// on success + error banner on failure.
//
// ─── 27-auth-hardening: Turnstile ──────────────────────────────────────────
// When TURNSTILE_SITE_KEY is set on the worker env (set by the harness or by
// supertools-design's deploy concern when 27-auth-hardening is installed),
// this form mounts the Cloudflare Turnstile widget and forwards the resulting
// token to the server as the `X-Turnstile-Token` header. The Better Auth
// hook in src/lib/auth.ts reads that header and rejects sign-ups without a
// valid token. When the site key is unset (i.e. 27-auth-hardening not
// installed, or the env var hasn't been provisioned yet) the widget simply
// doesn't render — the form continues to work normally, just without captcha.
//
// We deliberately pass the token via HEADER, not body, so Better Auth's
// schema validation never sees it and we don't need to configure
// `user.additionalFields` to whitelist a non-persisted field.
import { useState } from 'react';
import {
  createFileRoute,
  redirect,
  useNavigate,
  useRouter,
} from '@tanstack/react-router';
import { createServerFn } from '@tanstack/react-start';
import { env } from 'cloudflare:workers';
import { signUp } from '../../lib/auth-client';
import { getServerSession } from '../../lib/auth.functions';
import { Turnstile } from '../../components/Turnstile';

// Server-only — surfaces the public site key (NOT the secret) to the route
// loader so the client can mount the widget. Returns null when 27-auth-
// hardening isn't installed / the env var is unset; the form treats null as
// "no captcha".
const getTurnstileSiteKey = createServerFn({ method: 'GET' }).handler(
  async () => {
    const e = env as unknown as { TURNSTILE_SITE_KEY?: string };
    return e.TURNSTILE_SITE_KEY ?? null;
  },
);

export const Route = createFileRoute('/(auth)/sign-up')({
  component: SignUp,
  head: () => ({ meta: [{ title: 'Sign up' }] }),
  // Bounce already-authed users to the dashboard. Same server-function
  // pattern as 40-dashboard's route.tsx, just with the inverted condition.
  // Lives in beforeLoad so the redirect fires during SSR — the form never
  // gets a chance to render for an authed visitor.
  beforeLoad: async () => {
    const session = await getServerSession();
    if (session?.user) {
      throw redirect({ to: '/dashboard' });
    }
  },
  // Surface the Turnstile site key (may be null) to the component via the
  // loader. Done in a loader (not beforeLoad) so it runs after the auth
  // check — no point fetching it if we're about to redirect.
  loader: async () => {
    const turnstileSiteKey = await getTurnstileSiteKey();
    return { turnstileSiteKey };
  },
});

function SignUp() {
  const navigate = useNavigate();
  const router = useRouter();
  const { turnstileSiteKey } = Route.useLoaderData();
  const [email, setEmail] = useState('');
  const [name, setName] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState<string | null>(null);
  const [pending, setPending] = useState(false);
  const [turnstileToken, setTurnstileToken] = useState<string | null>(null);

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    setError(null);
    // Block submission when Turnstile is required but unsolved. The server-
    // side hook in src/lib/auth.ts is the actual gate — this is just a UX
    // optimization so the user gets immediate feedback instead of a 400
    // round-trip.
    if (turnstileSiteKey && !turnstileToken) {
      setError('Please complete the captcha before signing up.');
      return;
    }
    setPending(true);
    try {
      // Pass the Turnstile token as a header via the second-arg fetchOptions
      // (Better Auth's client surface). Keeping it out of the body avoids
      // tripping Better Auth's body-schema validation.
      const fetchOptions = turnstileToken
        ? { headers: { 'X-Turnstile-Token': turnstileToken } }
        : undefined;
      const res = await signUp.email(
        { email, password, name },
        fetchOptions,
      );
      if (res.error) {
        setError(res.error.message ?? 'Sign-up failed');
        // A failed sign-up consumes the Turnstile token (tokens are single-
        // use). Force the user to solve a fresh captcha before retrying.
        if (turnstileSiteKey) {
          setTurnstileToken(null);
          // Bouncing through the router triggers the widget's remount via
          // its component lifecycle, which gets us a fresh challenge.
          router.invalidate();
        }
      } else {
        navigate({ to: '/' });
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Sign-up failed');
    } finally {
      setPending(false);
    }
  }

  return (
    <main className="mx-auto flex max-w-sm flex-col px-4 py-12">
      <div className="rounded-lg bg-white p-6 shadow-md sm:p-8">
        <h1 className="mb-1 text-2xl font-semibold text-gray-900">Sign up</h1>
        <p className="mb-6 text-sm text-gray-600">Create your account</p>
        {error ? (
          <div className="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            {error}
          </div>
        ) : null}
        <form onSubmit={onSubmit} className="space-y-4">
          <div>
            <label
              htmlFor="email"
              className="mb-1 block text-sm font-medium text-gray-700"
            >
              Email
            </label>
            <input
              id="email"
              required
              type="email"
              placeholder="you@example.com"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-500"
              autoComplete="email"
            />
          </div>
          <div>
            <label
              htmlFor="name"
              className="mb-1 block text-sm font-medium text-gray-700"
            >
              Name
            </label>
            <input
              id="name"
              required
              type="text"
              placeholder="Your name"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-500"
              autoComplete="name"
            />
          </div>
          <div>
            <label
              htmlFor="password"
              className="mb-1 block text-sm font-medium text-gray-700"
            >
              Password
            </label>
            <input
              id="password"
              required
              type="password"
              placeholder="At least 8 characters"
              minLength={8}
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-500"
              autoComplete="new-password"
            />
          </div>
          {turnstileSiteKey ? (
            <div>
              <Turnstile
                siteKey={turnstileSiteKey}
                onToken={setTurnstileToken}
                onExpired={() => setTurnstileToken(null)}
              />
            </div>
          ) : null}
          <button
            type="submit"
            disabled={pending}
            className="w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700 disabled:opacity-50"
          >
            {pending ? 'Signing up…' : 'Sign up'}
          </button>
        </form>
        <p className="mt-6 text-center text-sm text-gray-600">
          Already have an account?{' '}
          <a
            href="/sign-in"
            className="text-blue-600 underline hover:text-blue-700"
          >
            Sign in
          </a>
        </p>
      </div>
    </main>
  );
}
