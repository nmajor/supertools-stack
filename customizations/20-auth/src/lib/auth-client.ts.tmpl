// Better Auth React client — used by `(auth)/sign-{in,up}.tsx` and any
// client-side code that wants `useSession`, `signIn`, `signOut`, etc.
//
// `baseURL` resolves at the call site:
//   - in the browser, `window.location.origin` works against the catch-all
//     server route at `/api/auth/$`.
//   - during SSR, `''` is fine because Better Auth's React client only issues
//     requests in client components (the SSR pass doesn't fire `signIn` etc).
import { createAuthClient } from 'better-auth/react';

export const authClient = createAuthClient({
  baseURL: typeof window !== 'undefined' ? window.location.origin : '',
});

export const { useSession, signIn, signUp, signOut } = authClient;
