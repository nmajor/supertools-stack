// Stack-wide fallback page rendered by the root route's errorComponent (500)
// and notFoundComponent (404). Plain Tailwind — same visual language as the
// auth pages (white card, neutral grays, blue accent link), so users hitting
// an error don't feel like they fell out of the app.
//
// No client-side JS state, no animation. The page is server-rendered and stays
// fully functional even when the React tree below it failed to hydrate.
import { Link } from '@tanstack/react-router';

type ErrorPageProps = {
  status: number;
  title: string;
  /**
   * Optional supporting copy. If omitted, a status-appropriate default is
   * used. Pass `null` to suppress entirely.
   */
  message?: string | null;
};

const DEFAULT_MESSAGES: Record<number, string> = {
  404: "The page you're looking for doesn't exist or has moved.",
  500: 'An unexpected error occurred. Try again in a moment.',
};

export function ErrorPage({ status, title, message }: ErrorPageProps) {
  const body =
    message === null
      ? null
      : (message ?? DEFAULT_MESSAGES[status] ?? 'Something went wrong.');

  return (
    <main className="mx-auto flex min-h-screen max-w-md flex-col items-center justify-center px-4 py-12">
      <div className="w-full rounded-lg bg-white p-8 text-center shadow-md">
        <p className="m-0 text-6xl font-semibold tracking-tight text-gray-900">
          {status}
        </p>
        <h1 className="mt-4 text-2xl font-semibold text-gray-900">{title}</h1>
        {body ? (
          <p className="mt-3 text-sm text-gray-600">{body}</p>
        ) : null}
        <Link
          to="/"
          className="mt-6 inline-block text-sm text-blue-600 underline hover:text-blue-700"
        >
          Back to home
        </Link>
      </div>
    </main>
  );
}
