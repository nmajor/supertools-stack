# Local-dev env vars. Copy to `.dev.vars` (gitignored) and fill in.
#
# The Cloudflare vite plugin loads `.dev.vars` and surfaces values via the
# `cloudflare:workers` env proxy — which is how the server reads them. A plain
# `.env` file would not reach the worker runtime; use `.dev.vars` for anything
# the worker imports.
#
# Production: provision each secret via `wrangler secret put <NAME>`. Non-secret
# vars can also live in `wrangler.jsonc` under `vars`.

# ─── Better Auth ────────────────────────────────────────────────────────────
# Random 32-byte hex; generated automatically by the 20-auth install step if
# `.dev.vars` doesn't already define one. Regenerate via `wrangler secret put
# BETTER_AUTH_SECRET` for production.
BETTER_AUTH_SECRET=<32-byte hex>
# Public URL the auth handler binds itself to. Local dev = http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# ─── Logging ────────────────────────────────────────────────────────────────
# One of: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# ─── Cloudflare D1 (production deploys only) ────────────────────────────────
# Local dev uses miniflare's in-memory D1 — no token / account ID needed.
# These are consumed by the deploy concern (in supertools-design), not by the
# stack template itself.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# ─── Transactional email (Ahasend) ──────────────────────────────────────────
# Consumed by src/lib/email.ts. If AHASEND_SECRET_KEY is empty / unset, the
# transport falls back to a no-op that logs to stdout (useful for local dev
# where you don't want sign-up / password-reset to send real mail). For
# production: provision via `wrangler secret put AHASEND_SECRET_KEY` (and
# `wrangler secret put AHASEND_ACCOUNT_ID`), then add the non-secret
# EMAIL_FROM_DOMAIN / EMAIL_FROM_NAME to `wrangler.jsonc`'s `vars`.
#
# AHASEND_SECRET_KEY: `aha-sk-…` 64-char bearer token. Must have scope
#   `messages:send:{your-from-domain}` (or `messages:send:all`).
# AHASEND_ACCOUNT_ID: account UUID. Path component of every Ahasend API URL.
# EMAIL_FROM_DOMAIN:  domain registered + verified with Ahasend. From-address
#                     is constructed as `noreply@<that-domain>`. Set this OR
#                     EMAIL_FROM_ADDRESS (one is required if AHASEND_SECRET_KEY
#                     is set). Typical pattern: `email.<your-root-domain>` —
#                     supertools-design's 80-email concern sets this up.
# EMAIL_FROM_ADDRESS: full from-address override. Use this if you want a
#                     non-`noreply@` localpart.
# EMAIL_FROM_NAME:    display name shown to recipients. Defaults to the
#                     project's PROJECT_NAME baked in at install time.
AHASEND_SECRET_KEY=
AHASEND_ACCOUNT_ID=
EMAIL_FROM_DOMAIN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
