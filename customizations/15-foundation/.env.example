# Local-dev env vars. Copy to `.dev.vars` (gitignored) and fill in.
#
# The Cloudflare vite plugin loads `.dev.vars` and surfaces values via the
# `cloudflare:workers` env proxy — which is how the server reads them. A plain
# `.env` file would not reach the worker runtime; use `.dev.vars` for anything
# the worker imports.
#
# Production: provision each secret via `wrangler secret put <NAME>`. Non-secret
# vars can also live in `wrangler.jsonc` under `vars`.

# ─── Better Auth ────────────────────────────────────────────────────────────
# Random 32-byte hex; generated automatically by the 20-auth install step if
# `.dev.vars` doesn't already define one. Regenerate via `wrangler secret put
# BETTER_AUTH_SECRET` for production.
BETTER_AUTH_SECRET=<32-byte hex>
# Public URL the auth handler binds itself to. Local dev = http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# ─── Logging ────────────────────────────────────────────────────────────────
# One of: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# ─── Cloudflare D1 (production deploys only) ────────────────────────────────
# Local dev uses miniflare's in-memory D1 — no token / account ID needed.
# These are consumed by the deploy concern (in supertools-design), not by the
# stack template itself.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
